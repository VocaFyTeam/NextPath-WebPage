# Environment: Development
# Description: Variables de entorno para desarrollo (Fake API local con json-server).
# Levanta la API con:  npm run server   (http://localhost:3000)
# Si prefieres usar la Fake API publicada en Render, comenta la siguiente línea y descomenta la otra.
VITE_NEXTPATH_API_URL="http://localhost:3000"
# VITE_NEXTPATH_API_URL="https://nextpath-mockups-api.onrender.com"

# En local la app se sirve desde la raíz.
VITE_BASE_PATH="/"

# IAM
VITE_USERS_ENDPOINT_PATH="/users"
# Assessments
VITE_VOCATIONAL_TESTS_ENDPOINT_PATH="/vocational-tests"
VITE_TEST_QUESTIONS_ENDPOINT_PATH="/test-questions"
VITE_TEST_RESULTS_ENDPOINT_PATH="/test-results"
# Career exploration
VITE_CAREERS_ENDPOINT_PATH="/careers"
VITE_FAVORITES_ENDPOINT_PATH="/favorites"
# Tasks
VITE_TASKS_ENDPOINT_PATH="/tasks"
# Counseling
VITE_COUNSELING_SESSIONS_ENDPOINT_PATH="/counseling-sessions"
VITE_CONVERSATIONS_ENDPOINT_PATH="/conversations"
VITE_MESSAGES_ENDPOINT_PATH="/messages"
# Community
VITE_COMMUNITIES_ENDPOINT_PATH="/communities"
VITE_THREADS_ENDPOINT_PATH="/threads"
VITE_COMMENTS_ENDPOINT_PATH="/comments"

# Monitoring (psychologist)
VITE_STUDENT_PROFILES_ENDPOINT_PATH="/student-profiles"
VITE_STUDENT_GROUPS_ENDPOINT_PATH="/student-groups"
# Resources (psychologist)
VITE_RESOURCES_ENDPOINT_PATH="/resources"

